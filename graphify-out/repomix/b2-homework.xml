<file path="backend/prisma/schema.prisma">
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AccountRole {
  parent
  student
  teacher
  admin
  super_admin
}

enum PermissionRisk {
  low
  medium
  high
  critical
}

enum StudentAccountRelationship {
  guardian
  student
  teacher
}

enum StudentGender {
  male
  female
  other
}

enum StudentGuardianRelationship {
  father
  mother
  grandfather
  grandmother
  guardian
  other
}

enum AttendancePeriod {
  morning
  afternoon
}

enum AttendanceStatus {
  present
  absent
  late
  excused
}

enum TuitionChargeStatus {
  unpaid
  partial
  paid
  waived
}

enum NewsPublicationStatus {
  draft
  published
  hidden
}

enum NewsAudienceType {
  all
  grade
  class
  student
}

model Account {
  id                 String               @id @default(uuid())
  username           String               @unique
  passwordHash       String               @map("password_hash")
  displayName        String               @map("display_name")
  role               AccountRole          @default(admin)
  isActive           Boolean              @default(true) @map("is_active")
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")
  permissions        AccountPermission[]
  refreshSessions    RefreshSession[]
  studentLinks       StudentAccountLink[]
  createdNews        NewsItem[]
  auditEvents        AuditEvent[]
  attendanceSessions AttendanceSession[]  @relation("AttendanceSessionCreator")
  attendanceRecords  AttendanceRecord[]   @relation("AttendanceRecordMarker")
  tuitionCharges     TuitionCharge[]      @relation("TuitionChargeCreator")
  homeroomClasses    SchoolClass[]        @relation("ClassHomeroomTeacher")

  @@map("accounts")
}

model Permission {
  id             String              @id @default(uuid())
  key            String              @unique
  label          String
  description    String
  boundedContext String              @map("bounded_context")
  risk           PermissionRisk      @default(low)
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  accounts       AccountPermission[]

  @@map("permissions")
}

model AccountPermission {
  accountId     String     @map("account_id")
  permissionKey String     @map("permission_key")
  assignedAt    DateTime   @default(now()) @map("assigned_at")
  account       Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  permission    Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([accountId, permissionKey])
  @@map("account_permissions")
}

model RefreshSession {
  id        String    @id @default(uuid())
  accountId String    @map("account_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@map("refresh_sessions")
}

model AuditEvent {
  id             String   @id @default(uuid())
  actorId        String   @map("actor_id")
  action         String
  boundedContext String   @map("bounded_context")
  resourceType   String   @map("resource_type")
  resourceId     String   @map("resource_id")
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")
  actor          Account  @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([actorId, createdAt])
  @@index([boundedContext, resourceType, resourceId])
  @@map("audit_events")
}

model Student {
  id                String                   @id @default(uuid())
  code              String                   @unique
  fullName          String                   @map("full_name")
  avatarUrl         String?                  @map("avatar_url")
  grade             String?
  className         String                   @map("class_name")
  schoolName        String                   @default("Sổ Liên Lạc Điện Tử") @map("school_name")
  isActive          Boolean                  @default(true) @map("is_active")
  dateOfBirth       DateTime?                @map("date_of_birth") @db.Date
  gender            StudentGender?
  ethnicity         String?
  birthPlace        String?                  @map("birth_place")
  permanentAddress  String?                  @map("permanent_address")
  cohortStartYear   Int?                     @map("cohort_start_year")
  cohortEndYear     Int?                     @map("cohort_end_year")
  createdAt         DateTime                 @default(now()) @map("created_at")
  updatedAt         DateTime                 @updatedAt @map("updated_at")
  accountLinks      StudentAccountLink[]
  guardianContacts  StudentGuardianContact[]
  attendanceRecords AttendanceRecord[]
  tuitionCharges    TuitionCharge[]
  enrollments       ClassEnrollment[]

  @@index([className])
  @@index([grade])
  @@index([isActive])
  @@map("students")
}

model StudentGuardianContact {
  id                 String                      @id @default(uuid())
  studentId          String                      @map("student_id")
