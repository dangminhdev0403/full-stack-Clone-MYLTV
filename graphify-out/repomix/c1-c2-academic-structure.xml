<file path="backend/prisma/schema.prisma">
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AccountRole {
  parent
  student
  teacher
  admin
  super_admin
}

enum PermissionRisk {
  low
  medium
  high
  critical
}

enum StudentAccountRelationship {
  guardian
  student
  teacher
}

enum StudentGender {
  male
  female
  other
}

enum StudentGuardianRelationship {
  father
  mother
  grandfather
  grandmother
  guardian
  other
}

enum AttendancePeriod {
  morning
  afternoon
}

enum AttendanceStatus {
  present
  absent
  late
  excused
}

enum TuitionChargeStatus {
  unpaid
  partial
  paid
  waived
}

enum NewsPublicationStatus {
  draft
  published
  hidden
}

enum NewsAudienceType {
  all
  grade
  class
  student
}

model Account {
  id                 String               @id @default(uuid())
  username           String               @unique
  passwordHash       String               @map("password_hash")
  displayName        String               @map("display_name")
  role               AccountRole          @default(admin)
  isActive           Boolean              @default(true) @map("is_active")
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")
  permissions        AccountPermission[]
  refreshSessions    RefreshSession[]
  studentLinks       StudentAccountLink[]
  createdNews        NewsItem[]
  auditEvents        AuditEvent[]
  attendanceSessions AttendanceSession[]  @relation("AttendanceSessionCreator")
  attendanceRecords  AttendanceRecord[]   @relation("AttendanceRecordMarker")
  tuitionCharges     TuitionCharge[]      @relation("TuitionChargeCreator")
  homeroomClasses    SchoolClass[]        @relation("ClassHomeroomTeacher")

  @@map("accounts")
}

model Permission {
  id             String              @id @default(uuid())
  key            String              @unique
  label          String
  description    String
  boundedContext String              @map("bounded_context")
  risk           PermissionRisk      @default(low)
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  accounts       AccountPermission[]

  @@map("permissions")
}

model AccountPermission {
  accountId     String     @map("account_id")
  permissionKey String     @map("permission_key")
  assignedAt    DateTime   @default(now()) @map("assigned_at")
  account       Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  permission    Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([accountId, permissionKey])
  @@map("account_permissions")
}

model RefreshSession {
  id        String    @id @default(uuid())
  accountId String    @map("account_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@map("refresh_sessions")
}

model AuditEvent {
  id             String   @id @default(uuid())
  actorId        String   @map("actor_id")
  action         String
  boundedContext String   @map("bounded_context")
  resourceType   String   @map("resource_type")
  resourceId     String   @map("resource_id")
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")
  actor          Account  @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([actorId, createdAt])
  @@index([boundedContext, resourceType, resourceId])
  @@map("audit_events")
}

model Student {
  id                String                   @id @default(uuid())
  code              String                   @unique
  fullName          String                   @map("full_name")
  avatarUrl         String?                  @map("avatar_url")
  grade             String?
  className         String                   @map("class_name")
  schoolName        String                   @default("Sổ Liên Lạc Điện Tử") @map("school_name")
  isActive          Boolean                  @default(true) @map("is_active")
  dateOfBirth       DateTime?                @map("date_of_birth") @db.Date
  gender            StudentGender?
  ethnicity         String?
  birthPlace        String?                  @map("birth_place")
  permanentAddress  String?                  @map("permanent_address")
  cohortStartYear   Int?                     @map("cohort_start_year")
  cohortEndYear     Int?                     @map("cohort_end_year")
  createdAt         DateTime                 @default(now()) @map("created_at")
  updatedAt         DateTime                 @updatedAt @map("updated_at")
  accountLinks      StudentAccountLink[]
  guardianContacts  StudentGuardianContact[]
  attendanceRecords AttendanceRecord[]
  tuitionCharges    TuitionCharge[]
  enrollments       ClassEnrollment[]

  @@index([className])
  @@index([grade])
  @@index([isActive])
  @@map("students")
}

model StudentGuardianContact {
  id                 String                      @id @default(uuid())
  studentId          String                      @map("student_id")
  relationship       StudentGuardianRelationship
  relationshipLabel  String?                     @map("relationship_label")
  fullName           String                      @map("full_name")
  phone              String
  isEmergencyContact Boolean                     @default(false) @map("is_emergency_contact")
  createdAt          DateTime                    @default(now()) @map("created_at")
  updatedAt          DateTime                    @updatedAt @map("updated_at")
  student            Student                     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([studentId, isEmergencyContact])
  @@map("student_guardian_contacts")
}

model StudentAccountLink {
  studentId    String                     @map("student_id")
  accountId    String                     @map("account_id")
  relationship StudentAccountRelationship @default(guardian)
  isActive     Boolean                    @default(true) @map("is_active")
  createdAt    DateTime                   @default(now()) @map("created_at")
  student      Student                    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  account      Account                    @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([studentId, accountId, relationship])
  @@index([accountId])
  @@index([studentId])
  @@map("student_account_links")
}

model NewsItem {
  id          String                @id @default(uuid())
  title       String
  summary     String
  content     String
  imageUrl    String?               @map("image_url")
  category    String
  status      NewsPublicationStatus @default(draft)
  isPinned    Boolean               @default(false) @map("is_pinned")
  sortOrder   Int                   @default(0) @map("sort_order")
  publishedAt DateTime?             @map("published_at")
  createdById String                @map("created_by_id")
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")
  createdBy   Account               @relation(fields: [createdById], references: [id], onDelete: Restrict)
  audiences   NewsAudience[]

  @@index([status, isPinned, sortOrder, publishedAt])
  @@index([createdById])
  @@map("news_items")
}

model NewsAudience {
  id     String           @id @default(uuid())
  newsId String           @map("news_id")
  type   NewsAudienceType
  value  String?
  news   NewsItem         @relation(fields: [newsId], references: [id], onDelete: Cascade)

  @@unique([newsId, type, value])
  @@index([type, value])
  @@map("news_audiences")
}

model AcademicYear {
  id          String        @id
  code        String        @unique
  displayName String        @map("display_name")
  startsOn    DateTime      @map("starts_on") @db.Date
  endsOn      DateTime      @map("ends_on") @db.Date
  isCurrent   Boolean       @default(false) @map("is_current")
  semesters   Semester[]
  classes     SchoolClass[]

  @@map("academic_years")
}

model Semester {
  id                 String              @id
  academicYearId     String              @map("academic_year_id")
  code               String
  displayName        String              @map("display_name")
  startsOn           DateTime            @map("starts_on") @db.Date
  endsOn             DateTime            @map("ends_on") @db.Date
  sortOrder          Int                 @map("sort_order")
  isCurrent          Boolean             @default(false) @map("is_current")
  academicYear       AcademicYear        @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  attendanceSessions AttendanceSession[]
  tuitionCharges     TuitionCharge[]

  @@unique([academicYearId, code])
  @@unique([academicYearId, sortOrder])
  @@index([academicYearId])
  @@map("semesters")
}

model GradeLevel {
  id          String        @id @default(uuid())
  code        String        @unique
  displayName String        @map("display_name")
  sortOrder   Int           @default(0) @map("sort_order")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  classes     SchoolClass[]

  @@map("grade_levels")
}

model SchoolClass {
  id                String            @id @default(uuid())
  academicYearId    String            @map("academic_year_id")
  gradeLevelId      String            @map("grade_level_id")
  code              String
  displayName       String            @map("display_name")
  homeroomTeacherId String?           @map("homeroom_teacher_id")
  isActive          Boolean           @default(true) @map("is_active")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  academicYear      AcademicYear      @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  gradeLevel        GradeLevel        @relation(fields: [gradeLevelId], references: [id], onDelete: Restrict)
  homeroomTeacher   Account?          @relation("ClassHomeroomTeacher", fields: [homeroomTeacherId], references: [id], onDelete: Restrict)
  enrollments       ClassEnrollment[]

  @@unique([academicYearId, code])
  @@index([academicYearId])
  @@index([gradeLevelId])
  @@index([homeroomTeacherId])
  @@map("school_classes")
}

model ClassEnrollment {
  id        String      @id @default(uuid())
  studentId String      @map("student_id")
  classId   String      @map("class_id")
  startsOn  DateTime?   @map("starts_on") @db.Date
  endsOn    DateTime?   @map("ends_on") @db.Date
  isActive  Boolean     @default(true) @map("is_active")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")
  student   Student     @relation(fields: [studentId], references: [id], onDelete: Restrict)
  class     SchoolClass @relation(fields: [classId], references: [id], onDelete: Restrict)

  @@index([studentId])
  @@index([classId])
  @@index([isActive])
  @@map("class_enrollments")
}

model AttendanceSession {
  id             String             @id @default(uuid())
  semesterId     String             @map("semester_id")
  attendanceDate DateTime           @map("attendance_date") @db.Date
  period         AttendancePeriod
  className      String             @map("class_name")
  createdById    String             @map("created_by_id")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")
  semester       Semester           @relation(fields: [semesterId], references: [id], onDelete: Restrict)
  createdBy      Account            @relation("AttendanceSessionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  records        AttendanceRecord[]

  @@unique([semesterId, attendanceDate, period, className])
  @@index([attendanceDate, className])
  @@index([createdById])
  @@map("attendance_sessions")
}

model AttendanceRecord {
  id         String            @id @default(uuid())
  sessionId  String            @map("session_id")
  studentId  String            @map("student_id")
  status     AttendanceStatus
  note       String?
  markedById String            @map("marked_by_id")
  createdAt  DateTime          @default(now()) @map("created_at")
  updatedAt  DateTime          @updatedAt @map("updated_at")
  session    AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student    Student           @relation(fields: [studentId], references: [id], onDelete: Restrict)
  markedBy   Account           @relation("AttendanceRecordMarker", fields: [markedById], references: [id], onDelete: Restrict)

  @@unique([sessionId, studentId])
  @@index([studentId, createdAt])
  @@index([markedById])
  @@map("attendance_records")
}

model TuitionCharge {
  id          String              @id @default(uuid())
  studentId   String              @map("student_id")
  semesterId  String              @map("semester_id")
  title       String
  amountDue   Int                 @map("amount_due")
  amountPaid  Int                 @default(0) @map("amount_paid")
  status      TuitionChargeStatus @default(unpaid)
  dueDate     DateTime?           @map("due_date") @db.Date
  note        String?
  isWaived    Boolean             @default(false) @map("is_waived")
  createdById String              @map("created_by_id")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")
  student     Student             @relation(fields: [studentId], references: [id], onDelete: Restrict)
  semester    Semester            @relation(fields: [semesterId], references: [id], onDelete: Restrict)
  createdBy   Account             @relation("TuitionChargeCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([studentId, semesterId, title])
  @@index([semesterId, status])
  @@index([studentId, status])
  @@index([dueDate])
  @@index([createdById])
  @@map("tuition_charges")
}

model Notification {
  id          String             @id @default(uuid())
  title       String
  sender      String
